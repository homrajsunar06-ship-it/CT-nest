        </div>

        <div class="category">
            <div class="category-icon">🏡</div>
            <h3>Buy House</h3>
        </div>

        <div class="category">
            <div class="category-icon">🌳</div>
            <h3>Land</h3>
        </div>

        <div class="category">
            <div class="category-icon">🏢</div>
            <h3>Commercial</h3>
        </div>

    </div>

</section>


<!-- FEATURED PROPERTIES -->
<section class="section">

    <div class="section-title">
        <h2>Featured Properties</h2>
        <p>Demo listings for the CTNest website.</p>
    </div>


    <div class="property-grid">

        <div class="property">

            <div class="property-image house-one"></div>

            <div class="property-info">

                <span class="badge">FOR RENT</span>

                <h3>Beautiful Family House</h3>

                <div class="price">
                    Rs. 25,000 / month
                </div>

                <div class="location">
                    📍 Bharatpur, Chitwan
                </div>

                <div class="details">
                    <span>🛏️ 3 Beds</span>
                    <span>🚿 2 Baths</span>
                    <span>🚗 Parking</span>
                </div>

            </div>

        </div>


        <div class="property">

            <div class="property-image house-two"></div>

            <div class="property-info">

                <span class="badge">FOR SALE</span>

                <h3>Modern House</h3>

                <div class="price">
                    Rs. 1.25 Crore
                </div>

                <div class="location">
                    📍 Ratnanagar, Chitwan
                </div>

                <div class="details">
                    <span>🛏️ 4 Beds</span>
                    <span>🚿 3 Baths</span>
                    <span>🚗 Parking</span>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- WHY CTNEST -->
<section class="why">

    <div class="section">

        <div class="section-title">
            <h2>Why CTNest?</h2>
            <p>Making property search easier for everyone.</p>
        </div>


        <div class="feature-grid">

            <div class="feature">
                <div class="feature-icon">📍</div>
                <h3>Find Nearby</h3>
                <p>
                    Search properties by location
                    and avoid unnecessary travelling.
                </p>
            </div>


            <div class="feature">
                <div class="feature-icon">🔎</div>
                <h3>Easy Search</h3>
                <p>
                    Filter properties by type,
                    budget and location.
                </p>
            </div>


            <div class="feature">
                <div class="feature-icon">🛡️</div>
                <h3>Trusted Listings</h3>
                <p>
                    Properties can be reviewed
                    before appearing on CTNest.
                </p>
            </div>

        </div>

    </div>

</section>


<!-- HOW IT WORKS -->
<section class="section">

    <div class="section-title">
        <h2>How CTNest Works</h2>
        <p>Finding your place can be simple.</p>
    </div>


    <div class="steps">

        <div class="step">

            <div class="step-number">1</div>

            <h3>Search</h3>

            <p>
                Search by location,
                property type and budget.
            </p>

        </div>


        <div class="step">

            <div class="step-number">2</div>

            <h3>View Property</h3>

            <p>
                Check photos, price,
                facilities and location.
            </p>

        </div>


        <div class="step">

            <div class="step-number">3</div>

            <h3>Contact Owner</h3>

            <p>
                Contact the owner
                and arrange a visit.
            </p>

        </div>

    </div>

</section>


<!-- POST PROPERTY -->
<section class="post-property">

    <h2>Have a Property?</h2>

    <p>
        Rent, sell or list your property
        on CTNest.
    </p>

    <div class="post-button">
        + Post Your Property
    </div>

</section>


<!-- FOOTER -->
<footer>

    <div class="footer-logo">
        CT<span>Nest</span>
    </div>

    <p>
        Find • Rent • Buy • Sell
    </p>

    <div class="footer-links">
        <span>Home</span>
        <span>Rent</span>
        <span>Buy</span>
        <span>Sell</span>
        <span>Contact</span>
    </div>

    <p>
        © 2026 CTNest. All rights reserved.
    </p>

</footer>

</body>
</html>